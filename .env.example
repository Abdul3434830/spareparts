# ─── Database (Neon Postgres) ────────────────────────────────────────────────
# Pooled connection URL — used at runtime by Prisma Client
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&pgbouncer=true"
# Direct (non-pooled) URL — used by Prisma Migrate / prisma db push
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# ─── Auth.js (NextAuth v5 beta) ───────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"
# Full public URL of the site (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# ─── Vercel Blob Storage ──────────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxx"

# ─── WhatsApp ─────────────────────────────────────────────────────────────────
# International format without + or spaces, e.g. 923001234567
NEXT_PUBLIC_WHATSAPP_NUMBER="923001234567"

# ─── Admin Seed User ─────────────────────────────────────────────────────────
# These are only used by the DB seed script to create the first admin account
ADMIN_EMAIL="admin@carespareparts.com"
ADMIN_PASSWORD="ChangeMe123!"
